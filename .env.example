# Скопируй в .env и заполни. Файл .env не коммитится.
# Бот: @BotFather → /newbot → TELEGRAM_BOT_TOKEN
# Chat ID: только цифры (не @ник!). Напиши боту «привет», затем:
# https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id":123456789
# После правок .env — manage.command → 2 (перезапуск)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PORT=8080
